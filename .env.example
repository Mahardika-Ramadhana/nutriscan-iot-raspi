# Salin file ini menjadi .env lalu isi kredensial sesuai lingkungan produksi.
# Jangan pernah commit file .env ke Git.

# API Key untuk endpoint write Web Dashboard lokal (wajib diisi jika memakai /api/tare, /api/trigger, dll)
NUTRISCAN_API_KEY=

# Kredensial Supabase Cloud Sync (jika sync.supabase.enabled: true)
NUTRISCAN_SUPABASE_URL=
NUTRISCAN_SUPABASE_KEY=

# Bearer Token untuk endpoint HTTP REST (jika sync.http.enabled: true)
NUTRISCAN_HTTP_TOKEN=

# Kredensial MQTT Broker (jika sync.mqtt.enabled: true)
NUTRISCAN_MQTT_USERNAME=
NUTRISCAN_MQTT_PASSWORD=
